+#ifdef __APPLE__
+/***********************************************************************
+ *           rosetta_add_cpu_features
+ *
+ * WineWrap: Rosetta's CPUID describes a CPU from about 2013, and leaf 7 (the newer
+ * feature flags) lacks CLFLUSHOPT, CLWB and RDPID. Programs built for a Skylake or
+ * Zen class CPU check for them, and copy protection built at that level never gets
+ * to the game without them.
+ *
+ * All three can be honoured: Rosetta runs CLFLUSHOPT, and CLWB and RDPID are run by
+ * emulate_rosetta_missing_instr. Rosetta answers CPUID from tables of {eax, ebx, ecx,
+ * edx} rows, one row per leaf, in the read-only image of its runtime that is mapped
+ * into every translated process. Set the three bits in this process's private copy
+ * of the leaf 7 rows. WINEWRAP_ROSETTA_CPUID7=0 leaves the CPU as Rosetta reports it.
+ */
+static void rosetta_add_cpu_features(void)
+{
+    const char *env = getenv( "WINEWRAP_ROSETTA_CPUID7" );
+    mach_vm_address_t addr = 0;
+    mach_vm_size_t size = 0;
+    unsigned int found = 0;
+
+    if (!is_rosetta2 || (env && !strcmp( env, "0" ))) return;
+    for (;; addr += size)
+    {
+        vm_region_basic_info_data_64_t info;
+        mach_msg_type_number_t count = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t object;
+        char path[1024];
+        unsigned int *p;
+        size_t i, n;
+
+        if (mach_vm_region( mach_task_self(), &addr, &size, VM_REGION_BASIC_INFO_64,
+                            (vm_region_info_t)&info, &count, &object )) break;
+        if ((info.protection & (VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE)) != (VM_PROT_READ | VM_PROT_EXECUTE))
+            continue;
+        if (proc_regionfilename( getpid(), addr, path, sizeof(path) ) <= 0) continue;
+        if (!strstr( path, "libRosettaRuntime" )) continue;
+
+        p = (unsigned int *)addr;
+        n = size / sizeof(*p);
+        for (i = 1; i + 8 * 4 <= n; i++)
+        {
+            unsigned int *leaf0 = p + i - 1, *leaf1 = leaf0 + 4, *leaf7 = leaf0 + 7 * 4;
+            mach_vm_address_t page;
+            mach_vm_size_t len;
+
+            /* leaf 0: the highest leaf, then "GenuineIntel" in ebx, edx, ecx */
