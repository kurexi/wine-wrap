+/***********************************************************************
+ *           emulate_rosetta_missing_instr
+ *
+ * WineWrap: Rosetta raises an invalid opcode for CLWB and RDPID. Once CPUID says the
+ * CPU has them (see rosetta_add_cpu_features), run them here:
+ *   CLWB m8      66 0F AE /6   writes a cache line back, which changes nothing a
+ *                              program can see, so it is skipped
+ *   RDPID r64    F3 0F C7 /7   reads the processor number Windows keeps in TSC_AUX
+ */
+static BOOL emulate_rosetta_missing_instr( ucontext_t *sigcontext )
+{
+    BYTE instr[15], prefix = 0, rex = 0, modrm;
+    unsigned int len, pos = 0;
+
+    if (!rosetta_cpu_features) return FALSE;
+    len = virtual_uninterrupted_read_memory( (BYTE *)RIP_sig(sigcontext), instr, sizeof(instr) );
+
+    for ( ; pos < len; pos++)  /* legacy prefixes */
+    {
+        if (instr[pos] == 0x66 || instr[pos] == 0xf3) prefix = instr[pos];
+        else if (instr[pos] != 0x26 && instr[pos] != 0x2e && instr[pos] != 0x36 && instr[pos] != 0x3e &&
+                 instr[pos] != 0x64 && instr[pos] != 0x65 && instr[pos] != 0x67) break;
+    }
+    if (pos < len && (instr[pos] & 0xf0) == 0x40) rex = instr[pos++];
+    if (pos + 3 > len || instr[pos] != 0x0f) return FALSE;
+    modrm = instr[pos + 2];
+
+    if (prefix == 0xf3 && instr[pos + 1] == 0xc7 && (modrm & 0xf8) == 0xf8)
+    {
+        ULONG_PTR value = NtGetCurrentProcessorNumber();
+
+        switch ((modrm & 7) | ((rex & 1) << 3))
+        {
+        case 0:  RAX_sig(sigcontext) = value; break;
+        case 1:  RCX_sig(sigcontext) = value; break;
+        case 2:  RDX_sig(sigcontext) = value; break;
+        case 3:  RBX_sig(sigcontext) = value; break;
+        case 4:  RSP_sig(sigcontext) = value; break;
+        case 5:  RBP_sig(sigcontext) = value; break;
+        case 6:  RSI_sig(sigcontext) = value; break;
+        case 7:  RDI_sig(sigcontext) = value; break;
+        case 8:  R8_sig(sigcontext)  = value; break;
+        case 9:  R9_sig(sigcontext)  = value; break;
+        case 10: R10_sig(sigcontext) = value; break;
+        case 11: R11_sig(sigcontext) = value; break;
+        case 12: R12_sig(sigcontext) = value; break;
+        case 13: R13_sig(sigcontext) = value; break;
+        case 14: R14_sig(sigcontext) = value; break;
+        case 15: R15_sig(sigcontext) = value; break;
+        }
+        RIP_sig(sigcontext) += pos + 3;
+        TRACE_(seh)( "emulated an RDPID instruction\n" );
+        return TRUE;
+    }
+
+    if (prefix == 0x66 && instr[pos + 1] == 0xae && (modrm >> 6) != 3 && ((modrm >> 3) & 7) == 6)
+    {
+        unsigned int mod = modrm >> 6, rm = modrm & 7;
+
+        pos += 3;
+        if (rm == 4)  /* SIB byte */
+        {
+            if (pos >= len) return FALSE;
+            if (mod == 0 && (instr[pos] & 7) == 5) pos += 4;  /* no base: disp32 */
+            pos++;
+        }
+        else if (mod == 0 && rm == 5) pos += 4;  /* rip-relative: disp32 */
+        if (mod == 1) pos += 1;
+        else if (mod == 2) pos += 4;
+        if (pos > len) return FALSE;
+        RIP_sig(sigcontext) += pos;
+        TRACE_(seh)( "emulated a CLWB instruction\n" );
+        return TRUE;
+    }
+    return FALSE;
+}
 #endif
 
