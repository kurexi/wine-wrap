+#ifdef __APPLE__
+/***********************************************************************
+ * WineWrap: execution breakpoints under Rosetta.
+ *
+ * Rosetta gives a thread no debug registers, so Wine only remembers Dr0-Dr7. A program
+ * that arms an execution breakpoint through its thread context (copy protection steers
+ * its control flow this way) waits for a debug exception that never comes.
+ *
+ * Stand-in that leaves the program's code as it is: the page of an armed breakpoint
+ * loses execute permission. A thread that enters the page faults, and is then
+ * single-stepped with the trap flag until it reaches its breakpoint, where the debug
+ * exception is raised, or leaves the page, which is protected again.
+ */
+struct rosetta_bp
+{
+    ULONG_PTR addr;     /* 0: free slot */
+    HANDLE    tid;      /* the thread whose debug registers hold it */
+    int       prot;     /* unix protection of its page */
+    BOOL      guarded;  /* execute permission is currently taken away */
+};
+static struct rosetta_bp rosetta_bps[16];
+static HANDLE rosetta_bp_steppers[16];  /* threads stepping through a breakpoint's page */
+static pthread_mutex_t rosetta_bp_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static inline BOOL rosetta_bp_same_page( ULONG_PTR a, ULONG_PTR b )
+{
+    return !((a ^ b) & ~(ULONG_PTR)0xfff);
+}
+
+static void rosetta_bp_guard( struct rosetta_bp *bp, BOOL guard )
+{
+    if (!bp->addr || bp->guarded == guard) return;
+    bp->guarded = guard;
+    mprotect( (void *)(bp->addr & ~(ULONG_PTR)0xfff), 0x1000, guard ? bp->prot & ~PROT_EXEC : bp->prot );
+}
+
+static void rosetta_bp_guard_all(void)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(rosetta_bps); i++) rosetta_bp_guard( &rosetta_bps[i], TRUE );
+}
+
+/* returns whether the thread was (step FALSE) or now is (step TRUE) stepping */
+static BOOL rosetta_bp_set_stepping( HANDLE tid, BOOL step )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(rosetta_bp_steppers); i++)
+    {
+        if (rosetta_bp_steppers[i] != tid) continue;
+        if (!step) rosetta_bp_steppers[i] = 0;
+        return TRUE;
+    }
+    if (!step) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(rosetta_bp_steppers); i++)
+        if (!InterlockedCompareExchangePointer( (void **)&rosetta_bp_steppers[i], tid, 0 )) return TRUE;
+    return FALSE;
+}
+
+/* the debug register of the current thread with an enabled execution breakpoint at addr, or -1 */
+static int rosetta_exec_bp_at( ULONG_PTR addr )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    DWORD_PTR dr[4] = { data->dr0, data->dr1, data->dr2, data->dr3 };
+    int i;
+
+    for (i = 0; i < 4; i++)
+    {
+        if (dr[i] != addr || !addr) continue;
+        if (!(data->dr7 & (3 << (i * 2)))) continue;   /* neither enable bit */
+        if ((data->dr7 >> (16 + i * 4)) & 3) continue;  /* a data breakpoint */
+        return i;
+    }
+    return -1;
+}
+
+/* make the protected pages match the current thread's debug registers. A breakpoint
+ * at the address the thread resumes from is left out: that instruction is the one
+ * that has to run next, as with the resume flag. */
+static void rosetta_update_exec_breakpoints( ULONG_PTR resume_rip )
+{
+    struct amd64_thread_data *data = amd64_thread_data();
+    DWORD_PTR dr[4] = { data->dr0, data->dr1, data->dr2, data->dr3 };
+    HANDLE tid = NtCurrentTeb()->ClientId.UniqueThread;
+    BOOL active = FALSE;
+    unsigned int i, j;
+
+    if (!is_rosetta2 || (!rosetta_bp_active && !(data->dr7 & 0xff))) return;
+
+    pthread_mutex_lock( &rosetta_bp_mutex );
+    for (j = 0; j < ARRAY_SIZE(rosetta_bps); j++)
+    {
+        if (!rosetta_bps[j].addr || rosetta_bps[j].tid != tid) continue;
+        rosetta_bp_guard( &rosetta_bps[j], FALSE );
+        rosetta_bps[j].addr = 0;
+    }
+    for (i = 0; i < 4; i++)
+    {
+        MEMORY_BASIC_INFORMATION info;
+
+        if (dr[i] == resume_rip || rosetta_exec_bp_at( dr[i] ) != i) continue;
+        if (NtQueryVirtualMemory( NtCurrentProcess(), (void *)dr[i], MemoryBasicInformation,
+                                  &info, sizeof(info), NULL ) || info.State != MEM_COMMIT) continue;
+        for (j = 0; j < ARRAY_SIZE(rosetta_bps); j++)
+        {
+            if (rosetta_bps[j].addr) continue;
+            rosetta_bps[j].tid = tid;
+            rosetta_bps[j].prot = PROT_READ | PROT_EXEC;
+            if (info.Protect & (PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY))
+                rosetta_bps[j].prot |= PROT_WRITE;
+            rosetta_bps[j].guarded = FALSE;
+            rosetta_bps[j].addr = dr[i];
+            TRACE_(seh)( "armed execution breakpoint %u at %p\n", i, (void *)dr[i] );
+            break;
+        }
+    }
+    /* pages are protected again here too, after a breakpoint in one of them was hit */
+    for (j = 0; j < ARRAY_SIZE(rosetta_bps); j++)
+    {
+        if (!rosetta_bps[j].addr) continue;
+        rosetta_bp_guard( &rosetta_bps[j], TRUE );
+        active = TRUE;
+    }
+    rosetta_bp_active = active;
+    pthread_mutex_unlock( &rosetta_bp_mutex );
+}
+
+/* raise the debug exception of the current thread's breakpoint in debug register reg */
+static void rosetta_bp_raise( int reg, ucontext_t *ucontext, EXCEPTION_RECORD *rec, struct xcontext *xcontext )
+{
+    ULONG_PTR rip = RIP_sig(ucontext);
+    unsigned int j;
+
+    /* the instruction has to run when the handler resumes it, so its page is opened;
+     * the next context the thread sets protects it again */
+    for (j = 0; j < ARRAY_SIZE(rosetta_bps); j++)
+    {
+        if (!rosetta_bps[j].addr || !rosetta_bp_same_page( rosetta_bps[j].addr, rip )) continue;
+        rosetta_bp_guard( &rosetta_bps[j], FALSE );
+    }
+    TRACE_(seh)( "execution breakpoint %d hit at %p\n", reg, (void *)rip );
+    /* Dr6 as hardware reads it: the reserved bits, and the breakpoint that was hit */
+    amd64_thread_data()->dr6 = 0xffff0ff0 | ((DWORD_PTR)1 << reg);
+    EFL_sig(ucontext) &= ~0x100;
+    xcontext->c.EFlags &= ~0x100;
+    xcontext->c.Dr6 = amd64_thread_data()->dr6;
+    rec->ExceptionCode = EXCEPTION_SINGLE_STEP;
+    rec->ExceptionAddress = (void *)rip;
+    rec->NumberParameters = 0;
+    setup_raise_exception( ucontext, rec, xcontext );
+}
+
+/* a fault: is the thread at one of its breakpoints, or entering a protected page? */
+static BOOL rosetta_bp_fault( ucontext_t *ucontext, EXCEPTION_RECORD *rec, struct xcontext *xcontext )
+{
+    HANDLE tid = NtCurrentTeb()->ClientId.UniqueThread;
+    ULONG_PTR rip = RIP_sig(ucontext);
+    BOOL entered = FALSE, stepping = FALSE;
+    unsigned int j;
+    int reg;
+
+    if (!is_rosetta2 || (!rosetta_bp_active && !(amd64_thread_data()->dr7 & 0xff))) return FALSE;
+
+    for (j = 0; j < ARRAY_SIZE(rosetta_bp_steppers); j++) if (rosetta_bp_steppers[j] == tid) stepping = TRUE;
+
+    /* on hardware the breakpoint comes before whatever the instruction itself does */
+    if (!stepping && (reg = rosetta_exec_bp_at( rip )) >= 0)
+    {
+        rosetta_bp_raise( reg, ucontext, rec, xcontext );
+        return TRUE;
+    }
+    for (j = 0; j < ARRAY_SIZE(rosetta_bps); j++)
+    {
+        if (!rosetta_bps[j].addr || !rosetta_bps[j].guarded) continue;
+        if (!rosetta_bp_same_page( rosetta_bps[j].addr, rip )) continue;
+        rosetta_bp_guard( &rosetta_bps[j], FALSE );
+        entered = TRUE;
+    }
+    if (entered)
+    {
+        if (rosetta_bp_set_stepping( tid, TRUE )) EFL_sig(ucontext) |= 0x100;
+        leave_handler( ucontext );
+        return TRUE;
+    }
+    if (stepping)
+    {
+        /* a fault of the program's own while it was being stepped: stop stepping */
+        rosetta_bp_set_stepping( tid, FALSE );
+        EFL_sig(ucontext) &= ~0x100;
+        xcontext->c.EFlags &= ~0x100;
+        rosetta_bp_guard_all();
+    }
+    return FALSE;
+}
+
+/* a single-step trap of a thread that is being stepped through a breakpoint's page */
+static BOOL rosetta_bp_step( ucontext_t *ucontext, EXCEPTION_RECORD *rec, struct xcontext *xcontext )
+{
+    HANDLE tid = NtCurrentTeb()->ClientId.UniqueThread;
+    ULONG_PTR rip = RIP_sig(ucontext);
+    unsigned int i, j;
+    int reg;
+
+    if (!is_rosetta2 || !rosetta_bp_active) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(rosetta_bp_steppers); i++) if (rosetta_bp_steppers[i] == tid) break;
+    if (i == ARRAY_SIZE(rosetta_bp_steppers)) return FALSE;
+
+    if ((reg = rosetta_exec_bp_at( rip )) >= 0)
+    {
+        rosetta_bp_set_stepping( tid, FALSE );
+        rosetta_bp_raise( reg, ucontext, rec, xcontext );
+        return TRUE;
+    }
+    for (j = 0; j < ARRAY_SIZE(rosetta_bps); j++)
+        if (rosetta_bps[j].addr && rosetta_bp_same_page( rosetta_bps[j].addr, rip )) break;
+    if (j < ARRAY_SIZE(rosetta_bps)) EFL_sig(ucontext) |= 0x100;  /* still inside: next instruction */
+    else
+    {
+        rosetta_bp_set_stepping( tid, FALSE );
+        EFL_sig(ucontext) &= ~0x100;
+        rosetta_bp_guard_all();
+    }
+    leave_handler( ucontext );
     return TRUE;
 }
+#endif  /* __APPLE__ */
 
 
